<!-- 108dp adaptive-icon canvas; artwork kept inside the central 66dp safe zone (21..87).
     Person silhouette with a check badge. All gaps and the check are real transparent
     cut-outs (no background-coloured strokes), so the same drawable works as the
     monochrome themed icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.82" android:scaleY="0.82"
        android:translateX="4.9" android:translateY="-1.2"> <!-- head centred at 54 -->
        <!-- head -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M37,42 A11,11 0 1,0 59,42 A11,11 0 1,0 37,42 Z" />
        <!-- shoulders, with a 3-unit gap cut around the badge (circle r=14 at 72,70) -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M28,80 C28,67 37,58 48,58 C52.62,58 56.89,59.59 60.28,62.4 A14,14 0 0,0 62.2,80 Z" />
        <!-- badge: circle r=11 at 72,70 with the check punched out (evenOdd) -->
        <path android:fillColor="#FFFFFF" android:fillType="evenOdd"
            android:pathData="M61,70 A11,11 0 1,0 83,70 A11,11 0 1,0 61,70 Z
                M64.59,71.41 L67.41,68.59 L70,71.17 L76.59,64.59 L79.41,67.41 L70,76.83 Z" />
    </group>
</vector>
