<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="28sp" />

        <Switch
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/toggle"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:text="@string/description"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Hidden until something has been blocked. -->
        <TextView
            android:id="@+id/blocked_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:visibility="gone" />

        <!-- Only shown once blocking can run; until then these switches couldn't do anything. -->
        <LinearLayout
            android:id="@+id/options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/options"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/instant_decline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/instant_decline"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/instant_decline_desc"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/repeat_callers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/repeat_callers"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/repeat_callers_desc"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <!-- Android 13+ only. Always shown there: Android can't tell us whether the tile is
                 already added, and asking again just reports that it is. -->
            <Button
                android:id="@+id/add_tile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_tile"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Shown in place of Options while blocking can't run; each row is hidden once granted. -->
        <LinearLayout
            android:id="@+id/permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:text="@string/permissions"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- A table so the buttons share one column, sized to the widest of them.
                 Column 0 (labels) takes the spare width and wraps if space runs out. -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shrinkColumns="0"
                android:stretchColumns="0">

                <TableRow
                    android:id="@+id/row_contacts"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <TextView
                        android:text="@string/perm_contacts"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                    <Button
                        android:id="@+id/open_app_info"
                        android:text="@string/app_info" />
                </TableRow>

                <TableRow
                    android:id="@+id/row_role"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <TextView
                        android:text="@string/perm_role"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                    <Button
                        android:id="@+id/open_default_apps"
                        android:text="@string/default_apps" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Footnote: divider, then the tip. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/builtin_note"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
